{
  "name": "@markbase/app",
  "version": "0.0.7",
  "private": true,
  "description": "Mac desktop shell for the Markbase ticketing + docs web app",
  "author": "Jessie Jia",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/fix-node-pty.cjs && npm run icon && tsup && vite build",
    "start": "node scripts/fix-node-pty.cjs && npm run build && electron .",
    "dist": "npm run build && electron-builder --mac",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.3.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.34.5",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.markbase-jia.ticketing",
    "productName": "Markbase",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "electronDist": "../../node_modules/electron/dist",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "identity": null
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Viewer",
        "rank": "Default"
      }
    ],
    "protocols": [
      {
        "name": "Markbase",
        "schemes": [
          "markbase"
        ]
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.216",
    "@markbase/agent": "*",
    "@markbase/docs": "*",
    "@markbase/flows": "*",
    "@markbase/protocol": "*",
    "@markbase/registry": "*",
    "@markbase/runner": "*",
    "@markbase/terms": "*",
    "@markbase/ui": "*",
    "@markbase/vault": "*",
    "@supabase/supabase-js": "^2.106.2",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
