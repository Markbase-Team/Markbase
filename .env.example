# Markbase self-hosting — copy to .env next to docker-compose.yml.
# SELF-HOSTING.md explains each value and where to find it.

# ---- Required ------------------------------------------------------------------

# The Supabase project this instance runs on (Project Settings → API).
# Public: these two are in every page the server renders. Read when the
# container starts, like everything else here — change them and
# `docker compose up -d` again; no rebuild.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The project's SECRET key (Project Settings → API Keys → secret key). Server
# only: the document API reads and writes with it. Never a NEXT_PUBLIC_ name.
# (SUPABASE_KEY is the same value under the name the hosted deployment uses;
# either name works, this one is the documented one.)
SUPABASE_SECRET_KEY=sb_secret_...

# Where your team reaches this instance. The login flow, share links and the
# API's own answers are built from it. No trailing slash.
APP_URL=https://markbase.example.com

# Encrypts the per-project secrets store. Generate once and keep it: rotating
# it makes every stored secret unreadable.   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# ---- Optional ------------------------------------------------------------------

# Host port the instance listens on (container port is always 3000).
MARKBASE_PORT=3000

# Which feature packages the build ships. Empty: the released product, which
# is Documents (docs). The other packages in packages/features — agents,
# attention, diary, email, projects, reader, skills, terms, today — are not
# released; name them, comma-separated, to ship them, or `all` for every one.
# The one value here that is compiled in: changing it means `--build`.
MARKBASE_FEATURES=

# Model access for the AI features (classify-unread, summaries). Off without it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Protects the /api/cron/* routes. Only needed if you schedule them (SELF-HOSTING.md).
CRON_SECRET=

# The email feature's Google OAuth app, and the key its stored tokens are
# encrypted with (openssl rand -base64 32). Leave empty to run without email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
TOKEN_ENC_KEY=
